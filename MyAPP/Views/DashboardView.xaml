<UserControl x:Class="MyAPP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="White" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator" HorizontalAlignment="Left" Width="4" Height="30" Background="{StaticResource BrushPrimary}" CornerRadius="2" Visibility="Collapsed" Margin="-17,0,0,0"/>
                                <ContentPresenter Grid.ColumnSpan="2"/>
                            </Grid>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.15" Color="#0d6efd"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBg}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnIconSquare}" 
                            Width="42" Height="42"
                            Margin="0,0,16,0"
                            ToolTip="Kembali ke Menu Utama"
                            Click="BtnBackToMenu_Click">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#374151"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Preset Manager" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Kelola templat coding dan variabel." FontSize="16" Foreground="#6b7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnWhite}" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileExport" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ekspor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnWhite}" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileImport" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Impor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPrimary}" Click="BtnNewPreset_Click" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Baru" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BtnLogout}" Margin="0,0,0,8" Click="BtnLogout_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Logout" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Log Out" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <TextBlock Text="DAFTAR PRESET" FontSize="12" FontWeight="Bold" Foreground="#6b7280" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Border Background="#e5e7eb" CornerRadius="12" Padding="12,4" DockPanel.Dock="Right">
                            <TextBlock x:Name="TxtPresetCount" Text="10 preset" FontSize="11" FontWeight="Bold" Foreground="#374151"/>
                        </Border>
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="ListPresets" Background="Transparent" BorderThickness="0" 
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="ListPresets_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#1f2937" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#f3f4f6" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                                <TextBlock Text="3 Templat" FontSize="10" Foreground="#6b7280"/>
                                            </Border>
                                            <Border Background="#f3f4f6" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="11 Var" FontSize="10" Foreground="#6b7280"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnIconSquare}" Margin="0,0,6,0"
                                                Tag="{Binding}" Click="BtnEditPreset_Click">
                                            <iconPacks:PackIconMaterial Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnIconSquare}"
                                                Tag="{Binding}" Click="BtnDeletePreset_Click">
                                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ViewActivePreset" Visibility="Visible">

                        <TextBlock x:Name="TxtActivePresetName" Text="RANGKUM" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Terakhir diperbarui: Baru saja" FontSize="14" Foreground="#6b7280" Margin="0,4,0,24"/>

                        <DockPanel Margin="0,0,0,32">
                            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="SIMPLE_1" Style="{StaticResource BtnPrimary}" Margin="0,0,12,8"/>
                                <Button Content="SIMPLE_2" Style="{StaticResource BtnWhite}" Margin="0,0,12,8"/>
                                <Button Content="DEPTH" Style="{StaticResource BtnWhite}" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Click="BtnAddTemplate_Click" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Templat" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="VARIABEL INPUT" FontWeight="Bold" FontSize="14" Foreground="#111827"/>
                                <TextBlock Text="Isi nilai di bawah ini untuk mengubah konten." FontSize="14" Foreground="#6b7280" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource BtnWhite}" HorizontalAlignment="Right" Click="BtnAddVariable_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Variabel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ItemsControl x:Name="ItemsVariables">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="12" BorderThickness="0" Margin="0,0,20,20" Width="350" Padding="20">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.03" Color="Black" Direction="270"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border HorizontalAlignment="Left" Background="#eef2ff" CornerRadius="20" Padding="16,6">
                                                    <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontWeight="Bold" Foreground="#4f46e5" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource BtnIconSquare}" Margin="0,0,8,0"
                                                                Tag="{Binding}" Click="BtnEditVariable_Click">
                                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Style="{StaticResource BtnIconSquare}"
                                                                Tag="{Binding}" Click="BtnDeleteVariable_Click">
                                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="1" Background="#f9fafb" CornerRadius="8" Padding="16" MinHeight="80">
                                                <TextBlock Text="{Binding DefaultValue, TargetNullValue='Isi nilai variabel...'}" 
                                                           Foreground="#4b5563" FontSize="14" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,24,0,50">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="White" CornerRadius="12,12,0,0" BorderBrush="#e5e7eb" BorderThickness="1,1,1,0" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#0d6efd" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                                            <TextBlock Text="PREVIEW" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Hasil akhir konten" FontSize="14" Foreground="#4b5563" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Edit Konten" Background="Transparent" Foreground="#0d6efd" FontWeight="Bold" 
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"
                                                Click="BtnEditPreviewContent_Click"/>
                                        <Button Style="{StaticResource BtnIconSquare}" Width="32" Height="32">
                                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="White" CornerRadius="0,0,12,12" BorderBrush="#e5e7eb" BorderThickness="1,0,1,1" Padding="24">
                                <StackPanel>
                                    <Border Background="#fcfcfc" BorderBrush="#f3f4f6" BorderThickness="1" CornerRadius="8" Padding="20" MinHeight="200">
                                        <TextBlock x:Name="TxtPreviewContent" FontFamily="Consolas" FontSize="14" Foreground="#374151" LineHeight="22" TextWrapping="Wrap"
                                                   Text="&lt;instruction&gt;Create a detailed, comprehensive, in-depth, and complex summary...&lt;/instruction&gt;&#x0a;&lt;instruction&gt;Include the main ideas and important information...&lt;/instruction&gt;"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                        <Button Style="{StaticResource BtnPrimary}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Salin Hasil" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnWhite}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cek Preview" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="ModalOverlay" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="Black" Opacity="0.5" MouseDown="BtnCloseModal_Click"/>

            <Border Background="White" CornerRadius="12" Width="600" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.3" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalIcon" Text="📝" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModalTitle" Text="Kelola Templat" FontSize="20" FontWeight="Bold" Foreground="#212529" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource BtnIconSquare}" BorderThickness="0" HorizontalAlignment="Right" Click="BtnCloseModal_Click">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <StackPanel x:Name="FormPreset" Visibility="Collapsed">
                            <TextBlock Text="Nama Preset" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <TextBox x:Name="InputPresetName" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel x:Name="FormVariable" Visibility="Collapsed">
                            <TextBlock Text="Templat" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <ComboBox x:Name="InputVarTemplate" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Nama" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <TextBox x:Name="InputVarKey" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" Margin="0,0,0,16"/>

                            <TextBlock Text="Default" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <TextBox x:Name="InputVarValue" Style="{StaticResource ModernTextBox}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <StackPanel x:Name="FormTemplate" Visibility="Collapsed">
                            <TextBlock Text="Judul" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <TextBox x:Name="InputTemplateTitle" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Konten" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#495057"/>
                            <TextBox x:Name="InputTemplateContent" Style="{StaticResource ModernTextBox}" 
                                     Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                     FontFamily="Consolas" VerticalContentAlignment="Top" 
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Batal" Style="{StaticResource BtnSecondaryPill}" Margin="0,0,12,0" Click="BtnCloseModal_Click"/>
                        <Button Content="Simpan" Style="{StaticResource BtnPrimary}" Click="BtnSaveModal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>